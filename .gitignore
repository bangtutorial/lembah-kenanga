var/

# Lembar periksa sementara saat meninjau aset — bukan bagian game
assets/sprites/**/_*_check.png
assets/sprites/**/preview_*.png

# Keluaran tools/publish.py — disusun ulang tiap kali, bukan sumber
dist/
dist.zip

